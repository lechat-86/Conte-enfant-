# Copiez ce fichier en ".env" (local) ou saisissez ces variables chez votre hébergeur.

# --- Adresse publique du site (sans "/" final) ---
SITE_URL=http://localhost:3000
PORT=3000

# --- Dossier de stockage (base de données + photos). En ligne : un disque persistant ! ---
DATA_DIR=./data

# --- Compte administrateur (créé/mis à jour au démarrage) ---
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long

# --- Paiement Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- E-mails (optionnel mais recommandé) : https://resend.com ---
RESEND_API_KEY=
MAIL_FROM=SHAÏ & GLOW <commandes@votre-domaine.fr>
